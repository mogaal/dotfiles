# Core settings
export EDITOR=nvim
export BROWSER=firefox

# Set the default Less options.
# Mouse-wheel scrolling has been disabled by -X (disable screen clearing).
# Remove -X and -F (exit if the content fits on one screen) to enable it.
export PAGER=less
export LESS='-F -g -i -M -R -S -w -X -z-4'

# Locales
export LANG=en_GB.UTF-8

# GPG
export NAME='Alejandro Garrido Mota'
export MAIL='garridomota@gmail.com'
export GPG_TTY=$(tty)

# Determine OS
if [[ "$(uname)" == "Darwin" ]]; then
  OS='mac'
elif [[ "$(uname -s)" == Linux* ]]; then
  OS='linux'
fi

# Architecture: my m1 uses arm and my desktop x86_64. Important because binaries are different
[[ $(uname -m) == arm* ]] && ARCH='arm'
[[ $(uname -m) == x86_64* ]] && ARCH='amd64'

# Debian packaging (only if debuild exists - work machine)
if command -v debuild &>/dev/null; then
  export DEBEMAIL='alejandro@debian.org'
  export DEBFULLNAME='Alejandro Garrido Mota'
  export QUILT_PATCHES=debian/patches
  export DEBUILD_DPKG_BUILDPACKAGE_OPTS="-us -uc -sa -i -I"
  export DEBSIGN_KEYID="F1C09EFB"
fi

# Terminal colors, required also vim-lightline
export TERM=xterm-256color

# Golang
export GO111MODULE=on

# KDE/Konsole fix
[[ -n "$_QT_SCREEN_SCALE_FACTORS" ]] && export QT_SCREEN_SCALE_FACTORS=$_QT_SCREEN_SCALE_FACTORS

# RVM (only if installed)
[[ -d "$HOME/.rvm" ]] && export PATH="$PATH:$HOME/.rvm/bin"

# Android Studio (only if installed)
if [[ "$OS" == "linux" ]]; then
  ANDROID_HOME=$HOME/Android/Sdk
else
  ANDROID_HOME=$HOME/Library/Android/sdk
fi

if [[ -d "$ANDROID_HOME" ]]; then
  export ANDROID_HOME
  export PATH=$PATH:$ANDROID_HOME/emulator
  export PATH=$PATH:$ANDROID_HOME/tools
  export PATH=$PATH:$ANDROID_HOME/tools/bin
  export PATH=$PATH:$ANDROID_HOME/platform-tools
fi

# Rust/Cargo (fix: use -f for file, not -d for directory)
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"
